mixin picture(name, alt, width = 800, height = 632, lazy = true, sizes = '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw')
  picture
    source(
      type="image/avif"
      srcset=`/assets/images/${name}-400.avif 400w, /assets/images/${name}-800.avif 800w`
      sizes=sizes
    )
    source(
      type="image/webp"
      srcset=`/assets/images/${name}-400.webp 400w, /assets/images/${name}-800.webp 800w`
      sizes=sizes
    )
    if lazy
      img(
        src=`/assets/images/${name}-800.jpg`
        alt=alt
        width=width
        height=height
        loading="lazy"
        decoding="async"
      )&attributes(attributes)
    else
      img(
        src=`/assets/images/${name}-800.jpg`
        alt=alt
        width=width
        height=height
        fetchpriority="high"
        decoding="async"
      )&attributes(attributes)